layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="compact-bar"
        }
        children
    }

    tab name="🏡" focus=true {
        pane
    }
    tab name="🌮 misc" {
        pane
    }
    tab name="💣 scratch" {
        pane
    }
    tab name="💎 p1" {
        pane
    }
    tab name="🪝 p2" {
        pane
    }
    tab name="🧩 p3" {
        pane
    }
}
