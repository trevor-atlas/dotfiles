{{- $isHsMachine := stat (joinPath .chezmoi.destDir ".hubspot") -}}
{{- if $isHsMachine -}}
{
  "providers": {
    "openai": {
      "baseUrl": "https://litellm.hubteamqa.com/v1",
      "apiKey": "!hsauthctl idp get-token",
      "authHeader": true
    },
    "anthropic": {
      "baseUrl": "https://litellm.hubteamqa.com",
      "apiKey": "!hsauthctl idp get-token",
      "authHeader": true
    }
  }
}
{{- else -}}
{{- $dsAPIKey := env "DEEPSEEK_API_KEY" -}}
{{- if not $dsAPIKey }}{{ fail "DEEPSEEK_API_KEY must be set when applying the personal Pi configuration" }}{{ end -}}
{{- $oaiAPIKey := env "OPENAI_API_KEY" -}}
{{- if not $oaiAPIKey }}{{ fail "OPENAI_API_KEY must be set when applying the personal Pi configuration" }}{{ end -}}
{{- $nfAPIKey := env "NINFER_API_KEY" -}}
{
  "providers": {
    "deepseek": {
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": {{ $dsAPIKey | toJson }}
    },
    "openai": {
      "apiKey": {{ $oaiAPIKey | toJson }}
    }
{{- if $nfAPIKey }}
    ,
    "ninfer": {
      "baseUrl": "http://192.168.50.178:8080/v1",
      "api": "openai-completions",
      "apiKey": {{ $nfAPIKey | toJson }},
      "compat": {
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "qwen3.8-27b",
          "name": "Qwen 3.8 27B (ninfer)",
          "reasoning": true,
          "contextWindow": 262144,
          "maxTokens": 32768,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "xhigh",
            "xhigh": "xhigh",
            "max": "xhigh"
          },
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
{{- end }}
  }
}
{{- end }}
