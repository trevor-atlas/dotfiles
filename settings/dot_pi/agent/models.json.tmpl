{{- $isHsMachine := stat (joinPath .chezmoi.destDir ".hubspot") -}}
{{- if $isHsMachine -}}
{
  "providers": {
    "litellm": {
      "baseUrl": "https://litellm.hubteamqa.com/v1",
      "apiKey": "!hsauthctl idp get-token",
      "api": "openai-completions",
      "models": [
        {
          "id": "anthropic/claude-opus-4-8",
          "name": "Claude Opus 4.8 (litellm)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 128000,
          "compat": { "cacheControlFormat": "anthropic" }
        },
        {
          "id": "anthropic/claude-opus-5",
          "name": "Claude Opus 5 (litellm)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 128000,
          "compat": { "cacheControlFormat": "anthropic" }
        },
        {
          "id": "anthropic/claude-sonnet-5",
          "name": "Claude Sonnet 5 (litellm)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 1048576,
          "maxTokens": 128000,
          "compat": { "cacheControlFormat": "anthropic" }
        },
        {
          "id": "openai/gpt-5.6-luna",
          "name": "GPT-5.6 Luna (litellm)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 400000,
          "maxTokens": 128000
        },
        {
          "id": "glm-5.3",
          "name": "GLM 5.3 (litellm)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 1048576,
          "maxTokens": 262144,
          "compat": { "thinkingFormat": "zai", "supportsReasoningEffort": true }
        }
      ]
    },
    "jetway": {
      "baseUrl": "https://service-mainline.app-jetway-internal-web.svc.iad03.k8s.run/v1",
      "apiKey": "!hsauthctl idp get-token",
      "api": "openai-completions",
      "headers": { "x-hubspot-ai-origin-id": "pi:jetway" },
      "models": [
        {
          "id": "glm-5.3-flash-hubspot",
          "name": "GLM 5.3 Flash HubSpot tune (jetway)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 1048576,
          "maxTokens": 262144,
          "compat": { "thinkingFormat": "zai", "supportsReasoningEffort": true }
        },
        {
          "id": "GLM-5.3-Flash",
          "name": "GLM 5.3 Flash (jetway)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 1048576,
          "maxTokens": 262144,
          "compat": { "thinkingFormat": "zai", "supportsReasoningEffort": true }
        },
        {
          "id": "GLM-5.3",
          "name": "GLM 5.3 (jetway)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 1048576,
          "maxTokens": 262144,
          "compat": { "thinkingFormat": "zai", "supportsReasoningEffort": true }
        },
        {
          "id": "GLM-5.2",
          "name": "GLM 5.2 (jetway)",
          "reasoning": true,
          "input": ["text"],
          "contextWindow": 1048576,
          "maxTokens": 262144,
          "compat": { "thinkingFormat": "zai", "supportsReasoningEffort": true }
        },
        {
          "id": "gpt-6-luna",
          "name": "GPT-6 Luna (jetway)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 400000,
          "maxTokens": 128000
        }
      ]
    },
    "jetway-anthropic": {
      "baseUrl": "https://service-mainline.app-jetway-internal-web.svc.iad03.k8s.run",
      "apiKey": "!hsauthctl idp get-token",
      "api": "anthropic-messages",
      "headers": { "x-hubspot-ai-origin-id": "pi:jetway" },
      "models": [
        {
          "id": "claude-boba-eap",
          "name": "Claude Boba EAP (jetway)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 64000
        },
        {
          "id": "claude-vanilla-eap",
          "name": "Claude Vanilla EAP (jetway)",
          "reasoning": true,
          "input": ["text", "image"],
          "contextWindow": 200000,
          "maxTokens": 64000
        }
      ]
    }
  }
}
{{- else -}}
{{- $dsAPIKey := env "DEEPSEEK_API_KEY" -}}
{{- if not $dsAPIKey }}{{ fail "DEEPSEEK_API_KEY must be set when applying the personal Pi configuration" }}{{ end -}}
{{- $oaiAPIKey := env "OPENAI_API_KEY" -}}
{{- if not $oaiAPIKey }}{{ fail "OPENAI_API_KEY must be set when applying the personal Pi configuration" }}{{ end -}}
{{- $nfAPIKey := env "NINFER_API_KEY" -}}
{
  "providers": {
    "deepseek": {
      "baseUrl": "https://api.deepseek.com/v1",
      "apiKey": {{ $dsAPIKey | toJson }}
    },
    "openai": {
      "apiKey": {{ $oaiAPIKey | toJson }}
    }
{{- if $nfAPIKey }}
    ,
    "ninfer": {
      "baseUrl": "http://192.168.50.178:8080/v1",
      "api": "openai-completions",
      "apiKey": {{ $nfAPIKey | toJson }},
      "compat": {
        "maxTokensField": "max_tokens"
      },
      "models": [
        {
          "id": "qwen3.8-27b",
          "name": "Qwen 3.8 27B (ninfer)",
          "reasoning": true,
          "contextWindow": 262144,
          "maxTokens": 32768,
          "thinkingLevelMap": {
            "off": "none",
            "minimal": "low",
            "low": "low",
            "medium": "medium",
            "high": "xhigh",
            "xhigh": "xhigh",
            "max": "xhigh"
          },
          "cost": { "input": 0, "output": 0, "cacheRead": 0, "cacheWrite": 0 }
        }
      ]
    }
{{- end }}
  }
}
{{- end }}
