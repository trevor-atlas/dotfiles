{{- /* chezmoi:modify-template */ -}}
{{- $input := .chezmoi.stdin -}}
{{- if not $input -}}
{{- $input = `{}` -}}
{{- end -}}
{{- $settings := fromJson $input -}}
{{- $packages := fromJson `[
  "npm:pi-mcp-adapter",
  "npm:pi-code-previews",
  "npm:pi-safety-net",
  "npm:@tintinweb/pi-subagents",
  "npm:pi-prompt-template-model",
  "npm:pi-web-access",
  "npm:@juicesharp/rpiv-ask-user-question",
  "npm:@ff-labs/pi-fff",
  "npm:pi-hermes-memory",
  "npm:@narumitw/pi-goal",
  "npm:pi-intercom"
]` -}}
{{- $settings
  | setValueAtPath "packages" $packages
  | setValueAtPath "defaultProvider" "deepseek"
  | setValueAtPath "defaultModel" "deepseek-v4-flash"
  | setValueAtPath "hideThinkingBlock" true
  | setValueAtPath "quietStartup" true
  | setValueAtPath "collapseChangelog" true
  | setValueAtPath "theme" "dark"
  | toPrettyJson -}}
