{{- /* chezmoi:modify-template */ -}}
{{- $input := .chezmoi.stdin -}}
{{- if not $input -}}
{{- $input = `{}` -}}
{{- end -}}
{{- $settings := fromJson $input -}}
{{- $isHsMachine := stat (joinPath .chezmoi.destDir ".hubspot") -}}
{{- $defaultProvider := "deepseek" -}}
{{- $defaultModel := "deepseek-v4-flash" -}}
{{- $workingVibeModel := "deepseek/deepseek-v4-flash" -}}
{{- if $isHsMachine -}}
{{- $defaultProvider = "litellm" -}}
{{- $defaultModel = "anthropic/claude-opus-4-8" -}}
{{- end -}}
{{- /* pi-interactive-subagents is vendored at settings/dot_pi/agent/packages/pi-interactive-subagents
       (chezmoi symlinks it to ~/.pi/agent/packages/pi-interactive-subagents); the relative
       ./packages/... source resolves against ~/.pi/agent/settings.json. */ -}}
{{- /* Vendored local packages (symlinked from settings/dot_pi/agent/packages/):
       pi-interactive-subagents, browser (Playwright web-driver tools), and
       web-fetch (Readability/Jina reader). The two runtime-dependency packages
       need a one-time `bun install` inside ~/.pi/agent/packages/{browser,web-fetch}`
       after chezmoi apply (their node_modules is chezmoi-ignored). */ -}}
{{- $packages := fromJson `[
  "npm:pi-mcp-adapter",
  "npm:pi-safety-net",
  "npm:pi-prompt-template-model",
  "./packages/pi-interactive-subagents",
  "./packages/browser",
  "./packages/web-fetch",
  "npm:@grammeaway/pi-clip",
  "npm:pi-observational-memory",
  "npm:@xynogen/pix-pretty"
]` -}}

{{- /* On HubSpot machines ~/.npmrc pins npm to the internal mirror (npm.hubteam.com),
       which does not serve the public pi packages. Force bun back to public npm there. */ -}}
{{- $npmCommand := fromJson `["bun"]` -}}
{{- if $isHsMachine -}}
{{- $npmCommand = fromJson `["bun", "--registry=https://registry.npmjs.org/"]` -}}
{{- end -}}
{{- $settings
  | setValueAtPath "npmCommand" $npmCommand
  | setValueAtPath "packages" $packages
  | setValueAtPath "defaultProvider" $defaultProvider
  | setValueAtPath "defaultModel" $defaultModel
  | setValueAtPath "enableSkillCommands" false
  | setValueAtPath "hideThinkingBlock" true
  | setValueAtPath "quietStartup" true
  | setValueAtPath "collapseChangelog" true
  | setValueAtPath "theme" "dark"
  | toPrettyJson -}}
