# Platform-specific entries, mirroring the old install.conf.yaml (macOS) vs
# install.conf.linux.yaml split. Patterns match TARGET paths.
{{ if eq .chezmoi.os "darwin" }}.i3{{ end }}
{{ if eq .chezmoi.os "darwin" }}.i3/**{{ end }}
{{ if ne .chezmoi.os "darwin" }}.config/skhd{{ end }}
{{ if ne .chezmoi.os "darwin" }}.config/skhd/**{{ end }}
{{ if ne .chezmoi.os "darwin" }}.config/yabai{{ end }}
{{ if ne .chezmoi.os "darwin" }}.config/yabai/**{{ end }}
{{ if ne .chezmoi.os "darwin" }}.config/brewfile{{ end }}
{{ if ne .chezmoi.os "darwin" }}.config/brewfile/**{{ end }}

# claude-connectors: connectors.json is generated per-machine by
# `bun connectors.ts sync` and contains account-specific installedServerId
# values — never commit it. The account token lives only in the keychain.
.config/claude-connectors/connectors.json

# Vendored pi extension packages carry real runtime deps installed by
# `bun install` on the target machine; never manage/commit their node_modules.
.pi/agent/packages/browser/node_modules
.pi/agent/packages/browser/node_modules/**
.pi/agent/packages/web-fetch/node_modules
.pi/agent/packages/web-fetch/node_modules/**
