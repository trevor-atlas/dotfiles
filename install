#!/usr/bin/env bash
# POSIX-compatible so `sh install` works on both macOS (sh=bash) and Ubuntu (sh=dash)

set -e

CONFIG="install.conf.yaml"
DOTBOT_DIR="dotbot"

DOTBOT_BIN="bin/dotbot"
BASEDIR="$(cd "$(dirname "$0")" && pwd)"

cd "${BASEDIR}"
git submodule update --init --recursive "${DOTBOT_DIR}"
git -C "${DOTBOT_DIR}" submodule sync --quiet --recursive

# macOS-only tweak: safe no-op on other platforms (defaults only exists on macOS)
if [ "$(uname -s)" = "Darwin" ]; then
  defaults write -g ApplePressAndHoldEnabled -bool false
fi

# Use the platform-appropriate dotbot config
if [ "$(uname -s)" = "Linux" ]; then
  CONFIG="install.conf.linux.yaml"
fi

"${BASEDIR}/${DOTBOT_DIR}/${DOTBOT_BIN}" -d "${BASEDIR}" -c "${CONFIG}" "${@}"
