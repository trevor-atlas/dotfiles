#!/usr/bin/env bash
# Bootstrap installer: makes sure chezmoi is present, then applies the source
# state (which includes the one-time macOS/brew run-once scripts).
# Replaces the old dotbot-based installer.
set -e

ATLAS_ROOT="$(cd "$(dirname "$0")" && pwd)"

# The dotfiles repo lives outside chezmoi's default source dir, so point
# chezmoi at it explicitly (one-time, idempotent).
CHEZMOI_CONFIG_DIR="$HOME/.config/chezmoi"
if [ ! -f "$CHEZMOI_CONFIG_DIR/chezmoi.toml" ]; then
  mkdir -p "$CHEZMOI_CONFIG_DIR"
  cat > "$CHEZMOI_CONFIG_DIR/chezmoi.toml" <<EOF
# Written by ~/.config/atlas/install
# The dotfiles repo is not in the default source dir, so tell chezmoi where it is.
sourceDir = "$ATLAS_ROOT"

# Symlink static files back to the source repo so they stay live-editable.
# Templates (.tmpl), scripts (run_once_*, modify_*) are still copied/rendered.
mode = "symlink"
EOF
  echo "==> Wrote $CHEZMOI_CONFIG_DIR/chezmoi.toml (sourceDir = $ATLAS_ROOT)"
fi

OS="$(uname -s)"

# On macOS, install chezmoi via Homebrew so it lands on PATH. Homebrew is a
# prerequisite for the rest of the macOS setup anyway (init/brew), so install
# it first if missing. Everywhere else, use the official get.chezmoi.io
# installer (OS/arch-aware, SHA-256 verified) into ~/.local/bin.
if [ "$OS" = "Darwin" ]; then
  if ! command -v brew >/dev/null 2>&1 && [ ! -x /opt/homebrew/bin/brew ] && [ ! -x /usr/local/bin/brew ]; then
    echo "==> Installing Homebrew …"
    NONINTERACTIVE=1 /bin/bash -c "$(curl -fsSL https://raw.githubusercontent.com/Homebrew/install/HEAD/install.sh)"
  fi

  if command -v brew >/dev/null 2>&1; then
    BREW="brew"
  elif [ -x /opt/homebrew/bin/brew ]; then
    BREW="/opt/homebrew/bin/brew"
  else
    BREW="/usr/local/bin/brew"
  fi

  if ! command -v chezmoi >/dev/null 2>&1; then
    echo "==> Installing chezmoi via Homebrew …"
    HOMEBREW_NO_AUTO_UPDATE=1 "$BREW" install chezmoi
  fi
else
  if ! command -v chezmoi >/dev/null 2>&1 && [ ! -x "$HOME/.local/bin/chezmoi" ]; then
    echo "==> Installing chezmoi to ~/.local/bin …"
    if command -v curl >/dev/null 2>&1; then
      curl -fsSL -o /tmp/chezmoi-install.sh https://get.chezmoi.io
    elif command -v wget >/dev/null 2>&1; then
      wget -qO /tmp/chezmoi-install.sh https://get.chezmoi.io
    else
      echo "Need curl or wget to download chezmoi." >&2
      exit 1
    fi
    sh /tmp/chezmoi-install.sh -b "$HOME/.local/bin"
  fi
fi

# Resolve the chezmoi binary. On a fresh macOS install, brew's bin dir isn't on
# PATH yet within this script, so check the well-known locations explicitly.
if command -v chezmoi >/dev/null 2>&1; then
  CHEZMOI="chezmoi"
elif [ -x /opt/homebrew/bin/chezmoi ]; then
  CHEZMOI="/opt/homebrew/bin/chezmoi"
elif [ -x /usr/local/bin/chezmoi ]; then
  CHEZMOI="/usr/local/bin/chezmoi"
else
  CHEZMOI="$HOME/.local/bin/chezmoi"
fi

# bat: the note/repo search helpers (ns, nl, rs) and some aliases call `bat`.
# fzf previews run outside the shell's alias scope, so a real `bat` binary is
# required. Install it if missing (Darwin via brew; Linux via the distro
# package manager). Debian/Ubuntu ship the binary as `batcat`, so link it as
# `bat` in ~/.local/bin. Optional: only warn when nothing can be done.
ensure_bat() {
  command -v bat >/dev/null 2>&1 && return 0

  if command -v batcat >/dev/null 2>&1; then
    link_batcat
    return 0
  fi

  if [ "$OS" = "Darwin" ]; then
    echo "==> Installing bat via Homebrew …"
    HOMEBREW_NO_AUTO_UPDATE=1 "$BREW" install bat
    return 0
  fi

  SUDO=""
  if [ "$(id -u)" -ne 0 ] && command -v sudo >/dev/null 2>&1; then
    SUDO="sudo"
  fi
  if [ "$(id -u)" -ne 0 ] && [ -z "$SUDO" ]; then
    echo "Warning: need root (or sudo) to install bat; skipping (search previews need it)." >&2
    return 0
  fi

  if command -v apt-get >/dev/null 2>&1; then
    echo "==> Installing bat via apt …"
    if ! $SUDO apt-get update -qq || ! $SUDO apt-get install -y bat; then
      echo "Warning: apt install of bat failed; continuing (search previews need it)." >&2
    fi
  elif command -v dnf >/dev/null 2>&1; then
    echo "==> Installing bat via dnf …"
    $SUDO dnf install -y bat || echo "Warning: dnf install of bat failed; continuing (search previews need it)." >&2
  elif command -v pacman >/dev/null 2>&1; then
    echo "==> Installing bat via pacman …"
    $SUDO pacman -S --noconfirm bat || echo "Warning: pacman install of bat failed; continuing (search previews need it)." >&2
  elif command -v zypper >/dev/null 2>&1; then
    echo "==> Installing bat via zypper …"
    $SUDO zypper --non-interactive install bat || echo "Warning: zypper install of bat failed; continuing (search previews need it)." >&2
  elif command -v apk >/dev/null 2>&1; then
    echo "==> Installing bat via apk …"
    $SUDO apk add bat || echo "Warning: apk install of bat failed; continuing (search previews need it)." >&2
  else
    echo "Warning: no package manager found; bat not installed (search previews need it)." >&2
  fi

  # After a distro install the binary may still be batcat (Debian/Ubuntu).
  if command -v batcat >/dev/null 2>&1; then
    link_batcat
  elif ! command -v bat >/dev/null 2>&1; then
    echo "Warning: bat still not available; search previews (ns/rs) need it." >&2
  fi
}

link_batcat() {
  mkdir -p "$HOME/.local/bin"
  if [ ! -e "$HOME/.local/bin/bat" ] && [ ! -L "$HOME/.local/bin/bat" ]; then
    ln -s "$(command -v batcat)" "$HOME/.local/bin/bat"
    echo "==> Linked ~/.local/bin/bat -> batcat"
  fi
}

ensure_bat

exec "$CHEZMOI" apply "$@"
