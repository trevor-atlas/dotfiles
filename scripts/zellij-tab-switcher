#!/usr/bin/env bash
set -euo pipefail

if ! command -v jq >/dev/null 2>&1; then
  echo "zellij-tab-switcher requires jq" >&2
  sleep 2
  exit 1
fi

if ! command -v fzf >/dev/null 2>&1; then
  echo "zellij-tab-switcher requires fzf" >&2
  sleep 2
  exit 1
fi

selection=$(
  zellij action list-tabs --all --json |
    jq -r '.[] | [((.position + 1) | tostring), (if .active then "*" else " " end), .name, (.tab_id | tostring)] | @tsv' |
    fzf --delimiter=$'\t' --with-nth=1,2,3 --prompt='tabs> ' --no-multi --cycle --reverse
) || exit 0

[[ -z "${selection}" ]] && exit 0

tab_id=$(awk -F'\t' '{print $4}' <<<"${selection}")
zellij action go-to-tab-by-id "${tab_id}"
