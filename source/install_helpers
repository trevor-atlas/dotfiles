#!/usr/bin/env bash

install_dotfiles_once() {
	# Full one-time setup. chezmoi's run_once scripts handle the macOS defaults,
	# Homebrew install, and directory creation on first apply.
	install_dotfiles
}

determine_os() {
	unameOut="$(uname -s)"
	case "${unameOut}" in
		Linux*)     machine=linux;;
		Darwin*)    machine=mac;;
		CYGWIN*)    machine=cygwin;;
		MINGW*)     machine=mingw;;
		*)          machine="UNKNOWN:${unameOut}"
	esac
	local __resultvar=$1
	if [[ "$__resultvar" ]]; then
		eval $__resultvar="'${machine}'"
	else
		echo "$machine"
	fi
}

